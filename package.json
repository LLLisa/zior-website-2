{
  "name": "zior-website",
  "version": "1.0.0",
  "description": "Zoom In On Recovery — content-managed meeting site",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "dev:host": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "heroku-postbuild": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b --noEmit",
    "seed:admin": "tsx server/scripts/make-admin.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "cross-env": "^7.0.3",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "resend": "^4.1.2",
    "tailwind-merge": "^3.0.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
