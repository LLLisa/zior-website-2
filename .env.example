# Copy to .env and fill in. All values have safe dev defaults except where noted.

# Postgres connection string. On Heroku this is provided automatically by the
# Heroku Postgres add-on. With `npm run dev` (Docker), the API container gets
# its own DATABASE_URL from docker-compose.yml and this value is ignored — it's
# only used if you run the server directly on the host (`npm run dev:host`).
# The dockerized Postgres is published on host port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/zior_db

# Port the Express API / production server listens on. Heroku sets PORT itself.
PORT=1953

# Public base URL of the site, used to build magic-link URLs in emails.
# With `npm run dev` (Docker) the app is served on http://localhost:1953 and
# compose sets this for you. Host mode (`npm run dev:host`) uses Vite's 5173.
APP_URL=http://localhost:1953

# Secret used to sign session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-insecure-change-me

# Email address that receives the initial admin account, seeded on first run.
ADMIN_EMAIL=you@example.com

# Resend API key. If unset, magic-link emails are printed to the server console
# instead of being sent (handy for local development).
RESEND_API_KEY=
FROM_EMAIL=ZIOR <login@zoominonrecovery.org>

# Set to "production" to serve the built SPA and terminate HTTPS with the
# certificates in ./secrets. Leave unset for local development.
# NODE_ENV=production
